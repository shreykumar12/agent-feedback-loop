# Copy to .env and fill in real values. .env is gitignored (it holds secrets);
# every variable read in agent_eval/config.py is listed here.
# No key? Use the offline simulated models: python main.py run --model sim-base

# --- LLM ---
GEMINI_API_KEY=
# Any other OpenAI-compatible endpoint (OpenAI, OpenRouter, Ollama, vLLM):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=
GENERATOR_MODEL=gemini-2.5-flash
JUDGE_MODEL=gemini-2.5-flash
TEMPERATURE=0
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=4

# --- Loop ---
MAX_TRIES=3
FEEDBACK_LEVEL=full
PROMPT_VERSION=v1

# --- Sandbox ---
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_PER_TEST_TIMEOUT_SECONDS=2
SANDBOX_MEMORY_LIMIT_MB=512

# --- Paths (optional overrides) ---
# AGENT_EVAL_DB=data/agent_eval.db
# AGENT_EVAL_TASKS=tasks/tasks.json
