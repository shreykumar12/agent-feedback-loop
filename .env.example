# WHY THIS FILE EXISTS:
#   .env is gitignored (it holds secrets), so this committed file documents
#   which variables someone cloning the repo must set.
#
# WHAT IT NEEDS:
#   Copy to .env and fill in real values. Every variable read in
#   agent_eval/config.py should appear here.

GEMINI_API_KEY=
GENERATOR_MODEL=gemini-2.5-flash
JUDGE_MODEL=gemini-2.5-flash
MAX_TRIES=3
